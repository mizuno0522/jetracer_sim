# sim PC でだけ要る外部パッケージ (Jetson には要らない)。scripts/setup_ws.sh が ros_ws/src に取り込む。
#   ROS-TCP-Endpoint: Unity ⇔ ROS 2 の TCP 中継 (sim_host.launch.py camera_backend:=unity が使う)
repositories:
  ros_tcp_endpoint:
    type: git
    url: https://github.com/Unity-Technologies/ROS-TCP-Endpoint.git
    version: main-ros2
