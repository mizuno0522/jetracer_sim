<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>imu_sim</name>
  <version>0.1.0</version>
  <description>vehicle_sim の物理状態 (/sim/body_state) から 6 軸 IMU (/imu) を合成する。指令からは作らない (設計 P8)</description>
  <maintainer email="mizuno0522@gmail.com">Hiroshi Mizuno</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>minicar_sim_msgs</exec_depend>
  <exec_depend>jetracer_common</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
